# Normalise les fins de ligne à LF pour les fichiers texte
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.md     text eol=lf

# Laisse Git gérer intelligemment les autres fichiers texte
* text=auto